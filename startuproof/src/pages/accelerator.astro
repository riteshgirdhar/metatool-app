---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Form from '../components/forms/Form.astro';
import Field from '../components/forms/Field.astro';
import { STAGE_OPTIONS } from '../components/forms/StageOptions';
---
<Base title="Startup Roof Accelerator" description="A structured programme for funded teams preparing to raise their next round. The programme is being designed; register interest to help shape it and to hear first when applications open." breadcrumbs={[{ name: 'Programmes' }, { name: 'Accelerator' }]}>
  <PageHero eyebrow="Programmes" title="Accelerator" lede="A structured programme for funded teams preparing to raise their next round. The programme is being designed; register interest to help shape it and to hear first when applications open."><div style="margin-top: var(--s4)"><StatusBadge status="planned" text="Programme in design" /></div></PageHero>
  <section class="section tight"><div class="container split">
    <div class="stack">
      <h2 style="font-size: var(--fs-xl)">Who it's for</h2><ul><li>Incorporated companies with a live product and early revenue or strong usage.</li><li>Teams planning to raise within 12 months.</li></ul>
      <h2 style="font-size: var(--fs-xl)">What it will focus on</h2><ul><li>Investor readiness, using Founder OS.</li><li>Mentor office hours and investor introductions.</li><li>A demo day at Founder Festival (planned).</li></ul>
      <div class="notice warn"><strong>Not yet confirmed</strong>Cohort dates, size, any investment terms and fees. We will publish them before applications open.</div>
    </div>
    <div class="form-panel">
      <h2 style="font-size: var(--fs-lg)">Register interest</h2>
      <Form type="programme" id="accelerator-interest" submitLabel="Register interest" success="You're on the Accelerator interest list.">
        <input type="hidden" name="programme" value="accelerator" />
        <div class="form-row two"><Field form="accelerator-interest" name="name" label="Name" required autocomplete="name" /><Field form="accelerator-interest" name="email" label="Email" type="email" required autocomplete="email" /></div>
        <Field form="accelerator-interest" name="company" label="Company (if any)" autocomplete="organization" />
        <Field form="accelerator-interest" name="stage" label="Stage" type="select" required options={STAGE_OPTIONS} />
        <Field form="accelerator-interest" name="message" label="Anything you'd like us to know?" type="textarea" />
      </Form>
    </div>
  </div></section>
</Base>
