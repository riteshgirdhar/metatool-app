---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Form from '../components/forms/Form.astro';
import Field from '../components/forms/Field.astro';
import { STAGE_OPTIONS } from '../components/forms/StageOptions';
---
<Base title="Startup Roof Incubator" description="Support from idea to first customers: validation, a first product and early traction. The programme is being designed; register interest to hear first when it opens." breadcrumbs={[{ name: 'Programmes' }, { name: 'Incubator' }]}>
  <PageHero eyebrow="Programmes" title="Incubator" lede="Support from idea to first customers: validation, a first product and early traction. The programme is being designed; register interest to hear first when it opens."><div style="margin-top: var(--s4)"><StatusBadge status="planned" text="Programme in design" /></div></PageHero>
  <section class="section tight"><div class="container split">
    <div class="stack">
      <h2 style="font-size: var(--fs-xl)">Who it's for</h2><ul><li>Founders at idea or pre-seed stage, including students and researchers.</li><li>Teams ready to commit time to customer discovery.</li></ul>
      <h2 style="font-size: var(--fs-xl)">What it will focus on</h2><ul><li>Academy tracks 1–3 with weekly check-ins.</li><li>Mentor office hours.</li><li>A path into the accelerator for teams that gain traction.</li></ul>
      <div class="notice warn"><strong>Not yet confirmed</strong>Cohort dates, size, any investment terms and fees. We will publish them before applications open.</div>
    </div>
    <div class="form-panel">
      <h2 style="font-size: var(--fs-lg)">Register interest</h2>
      <Form type="programme" id="incubator-interest" submitLabel="Register interest" success="You're on the Incubator interest list.">
        <input type="hidden" name="programme" value="incubator" />
        <div class="form-row two"><Field form="incubator-interest" name="name" label="Name" required autocomplete="name" /><Field form="incubator-interest" name="email" label="Email" type="email" required autocomplete="email" /></div>
        <Field form="incubator-interest" name="company" label="Company (if any)" autocomplete="organization" />
        <Field form="incubator-interest" name="stage" label="Stage" type="select" required options={STAGE_OPTIONS} />
        <Field form="incubator-interest" name="message" label="Anything you'd like us to know?" type="textarea" />
      </Form>
    </div>
  </div></section>
</Base>
