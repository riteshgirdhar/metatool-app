---
interface Props { title: string; text: string; primary: { label: string; href: string }; secondary?: { label: string; href: string } }
const { title, text, primary, secondary } = Astro.props;
---
<section class="section tight">
  <div class="container">
    <div class="cta-band">
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="cluster">
        <a class="btn btn-primary btn-lg" href={primary.href}>{primary.label}</a>
        {secondary && <a class="btn btn-secondary btn-lg" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>
