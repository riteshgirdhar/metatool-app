---
export interface Crumb { name: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{c.href && i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current={i === items.length - 1 ? 'page' : undefined}>{c.name}</span>}</li>
    ))}
  </ol>
</nav>
