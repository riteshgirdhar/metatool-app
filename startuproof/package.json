{
  "name": "startuproof-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "astro check",
    "lint": "node scripts/lint.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "npm run build && npm run build:e2e && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "build:e2e": "PUBLIC_SUPABASE_URL=http://localhost:4322/mock-supabase PUBLIC_SUPABASE_ANON_KEY=test-anon-key astro build --outDir dist-e2e",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@netlify/blobs": "11.1.4",
    "@supabase/supabase-js": "2.117.3",
    "astro": "7.3.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@netlify/functions": "6.0.2",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.1",
    "lighthouse": "13.5.0",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  }
}
