# Copy to .env for local development. Never commit real values.
# Public (exposed to the browser by design): Supabase project URL and anon/publishable key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only (Netlify Functions): salt for hashing client IPs and referral codes. Set as a secret in Netlify.
SR_HASH_SALT=
# Optional: comma-separated extra origins allowed to POST forms (the site's own host is always allowed).
SR_ALLOWED_ORIGINS=
# Keep "false" until the domain migration is approved.
SITE_INDEXABLE=false
